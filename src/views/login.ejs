<%- include('includes/header') %>

<!-- Ikonkalar uchun FontAwesome -->
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
/>
<link rel="stylesheet" type="text/css" href="/css/login.css" />

<body>
  <div class="login-container">
    <div class="login-card">
      <!-- Sarlavha qismi -->
      <h2 class="title">XUSH KELIBSIZ 👋</h2>
      <p class="subtitle">
        Go back <a href="/admin">Home</a> | Sign in to continue
      </p>

      <form
        class="login-form"
        action="/admin/login"
        METHOD="POST"
        autocomplete="off"
      >
        <!-- Username input -->
        <div class="input-group">
          <label>CHayhana-market *</label>
          <div class="input-wrapper">
            <i class="fa-regular fa-user icon"></i>
            <input
              type="text"
              name="memberNick"
              class="member-nick"
              placeholder="Enter your username"
              autocomplete="new-password"
              required
            />
          </div>
        </div>

        <!-- Password input -->
        <div class="input-group">
          <label>Password *</label>
          <div class="input-wrapper">
            <i class="fa-solid fa-lock icon"></i>
            <input
              type="password"
              name="memberPassword"
              id="memberPassword"
              class="member-password"
              placeholder="Enter your password"
              autocomplete="new-password"
              required
            />
            <i
              class="fa-regular fa-eye toggle-password"
              id="togglePassword"
              style="cursor: pointer"
            ></i>
          </div>
        </div>

        <div class="forgot-pass">
          <a href="#">Forgot Password?</a>
        </div>

        <!-- Submit Tugmasi -->
        <button type="submit" class="btn-login" name="login">Login</button>
      </form>

      <!-- Ajratuvchi chiziq -->
      <div class="divider">
        <span>Or continue with</span>
      </div>

      <!-- Social Media tugmalari -->
      <div class="social-login">
        <a
          href="https://www.instagram.com/chayhanamart"
          class="social-btn google"
        >
          <i class="fa-brands fa-instagram" style="color: #1877f2"></i>
        </a>
        <a
          href="https://web.telegram.org/k/#@chayhanamarket"
          class="social-btn telegram"
        >
          <i class="fa-brands fa-telegram" style="color: #1877f2"></i>
        </a>
        <a
          href="https://github.com/yuldashevsamandar9-coder"
          class="social-btn github"
        >
          <i class="fa-brands fa-github" style="color: #000"></i>
        </a>
      </div>

      <!-- Ro'yxatdan o'tish linki -->
      <p class="signup-text">
        Don't have an account? <a href="/admin/signup">Sign up</a>
      </p>
    </div>
  </div>
</body>

<%- include('includes/footer') %>
